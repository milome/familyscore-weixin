.container {
  min-height: 100vh;
  background: var(--background);
  padding: 24rpx;
}

.header {
  margin-bottom: 32rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-primary);
}

.test-results {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 48rpx;
}

.test-item {
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.test-item:last-child {
  border-bottom: none;
}

.test-name {
  font-size: 32rpx;
  color: var(--text-primary);
}

.test-message {
  font-size: 28rpx;
}

.test-item.success {
  background: rgba(7, 193, 96, 0.1);
}

.test-item.success .test-message {
  color: var(--success-color);
}

.test-item.fail {
  background: rgba(250, 81, 81, 0.1);
}

.test-item.fail .test-message {
  color: var(--error-color);
}