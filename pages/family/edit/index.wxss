.container {
  min-height: 100vh;
  background: var(--background);
  padding: 24rpx;
  padding-top: calc(88rpx + env(safe-area-inset-top));
}

.form {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.input {
  height: 80rpx;
  background: var(--background);
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
}

/* 角色选择网格 */
.role-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
}

.role-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: var(--background);
  border-radius: 12rpx;
  transition: all 0.3s;
}

.role-item.active {
  background: var(--primary-color);
}

.role-item.active .icon,
.role-item.active .name {
  color: #fff;
}

.role-item .icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.role-item .name {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.save-btn {
  margin-top: 48rpx;
  border-radius: 48rpx;
}

/* 导航按钮样式 */
.back-btn,
.nav-btn {
  font-size: 28rpx;
  padding: 12rpx 24rpx;
}

.back-btn {
  color: var(--text-primary);
}

.nav-btn {
  color: var(--primary-color);
} 