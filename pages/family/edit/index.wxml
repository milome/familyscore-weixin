<nav-bar title="{{mode === 'add' ? '添加家人' : '编辑家人'}}">
  <view slot="left">
    <text class="back-btn" bindtap="goBack">返回</text>
  </view>
  <view slot="right">
    <navigator url="/pages/index/index" open-type="switchTab" hover-class="none">
      <text class="nav-btn">返回首页</text>
    </navigator>
  </view>
</nav-bar>

<view class="container">
  <view class="form">
    <!-- 姓名输入 -->
    <view class="form-item">
      <text class="label">姓名</text>
      <input 
        class="input" 
        value="{{name}}"
        placeholder="请输入家人姓名"
        bindinput="onNameInput"
      />
    </view>

    <!-- 手机号码输入 -->
    <view class="form-item">
      <text class="label">手机号码</text>
      <input 
        class="input" 
        type="number"
        maxlength="11"
        value="{{phone}}"
        placeholder="请输入手机号码"
        bindinput="onPhoneInput"
      />
    </view>

    <!-- 角色选择 -->
    <view class="form-item">
      <text class="label">角色</text>
      <view class="role-grid">
        <view 
          class="role-item {{selectedRole.id === role.id ? 'active' : ''}}"
          wx:for="{{roleList}}"
          wx:key="id"
          wx:for-item="role"
          data-role="{{role}}"
          bindtap="selectRole"
        >
          <text class="icon">{{role.icon}}</text>
          <text class="name">{{role.name}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 保存按钮 -->
  <button 
    class="save-btn" 
    type="primary" 
    loading="{{loading}}"
    bindtap="onSave"
  >保存</button>
</view> 