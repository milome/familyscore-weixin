<!--pages/settings/index.wxml-->
<nav-bar title="设置" />

<view class="user-info" wx:if="{{userInfo}}">
  <image class="avatar" src="{{userInfo.avatarUrl || '/images/default-avatar.png'}}" />
  <view class="info">
    <text class="nickname">{{userInfo.nickName || '未设置昵称'}}</text>
    <text class="tip">点击修改个人信息</text>
  </view>
</view>

<view class="settings-list">
  <list-item
    title="个人信息"
    arrow
    bindtap="editProfile"
  />
  <list-item
    title="关于我们"
    arrow
    bindtap="showAbout"
  />
  <list-item
    title="清除缓存"
    arrow
    bindtap="clearCache"
  />
</view>