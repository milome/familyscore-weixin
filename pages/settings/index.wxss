/* pages/settings/index.wxss */
.user-info {
  display: flex;
  align-items: center;
  padding: 32rpx 24rpx;
  background: #fff;
  margin-bottom: 24rpx;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.info {
  flex: 1;
}

.nickname {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 8rpx;
}

.tip {
  font-size: 24rpx;
  color: #999;
}

.settings-list {
  background: #fff;
}