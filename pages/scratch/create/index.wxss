.container {
  min-height: 100vh;
  background: var(--background);
  padding: 24rpx;
}

.form-group {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.form-item {
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.input {
  width: 100%;
  height: 80rpx;
  padding: 0 24rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  box-sizing: border-box;
}

.textarea {
  width: 100%;
  height: 160rpx;
  padding: 24rpx;
  border: 1rpx solid var(--border-color);
  border-radius: 8rpx;
  box-sizing: border-box;
}

.footer {
  margin-top: 48rpx;
  padding: 0 24rpx;
}

.submit-btn {
  margin-bottom: 24rpx;
} 