.header {
  text-align: center;
  padding: 60rpx 0 30rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.header-title {
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
}

.list {
  padding: 30rpx 20rpx;
}

.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 20rpx;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.card-content {
  flex: 1;
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  color: #333;
}

.points {
  font-size: 28rpx;
  color: #07c160;
  font-weight: bold;
}

.card-actions {
  padding-left: 20rpx;
}

.action-btn {
  padding: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: none;
  border: none;
  font-size: 32rpx;
}

.action-btn::after {
  display: none;
}

.btn-hover {
  opacity: 0.7;
}

/* 悬浮添加按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 40rpx;
  width: 100rpx;
  height: 100rpx;
  background: #07c160;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.2);
}

.fab-icon {
  color: #fff;
  font-size: 60rpx;
  font-weight: bold;
}