.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.create-btn {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  height: 72rpx;
  background: #07c160;
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.create-btn .icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}

.card-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-top: 24rpx;
}

.card-list.no-header {
  padding-top: 0;
}

.loading {
  padding: 48rpx;
  text-align: center;
  color: #999;
  font-size: 28rpx;
}

.empty {
  padding: 96rpx 48rpx;
  text-align: center;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.card-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.card-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 24rpx;
}

.card-info {
  flex: 1;
}

.card-name {
  font-size: 32rpx;
  color: #333;
  margin-bottom: 12rpx;
}

.card-meta {
  display: flex;
  gap: 24rpx;
}

.points {
  font-size: 28rpx;
  color: #07c160;
  font-weight: bold;
}

.stock {
  font-size: 28rpx;
  color: #999;
}

.card-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: none;
  border: 1rpx solid #eee;
  border-radius: 50%;
}

.action-btn::after {
  border: none;
}

.action-btn .icon {
  font-size: 32rpx;
}

.settings-group {
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 12rpx;
}

.group-title {
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  border-bottom: 1rpx solid var(--border-color);
}

.card-list {
  padding: 24rpx;
}

.card-item {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.card-content {
  flex: 1;
}

.card-item .title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.card-item .desc {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.card-item .points {
  font-size: 24rpx;
  color: var(--primary-color);
}

.card-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  padding: 0;
  line-height: 64rpx;
  text-align: center;
  background: none;
  border: none;
}

.action-btn::after {
  display: none;
}

.btn-hover {
  opacity: 0.7;
}