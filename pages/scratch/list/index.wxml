<!-- 页面标题 -->
<view class="header">
  <text class="header-title">刮刮卡管理</text>
</view>

<view class="list">
  <view class="card" 
    wx:for="{{list}}" 
    wx:key="_id"
  >
    <view class="card-content" bindtap="goToEdit" data-id="{{item._id}}">
      <view class="title">{{item.title}}</view>
      <view class="points {{item.points >= 0 ? 'positive' : 'negative'}}">
        {{item.points >= 0 ? '+' : ''}}{{item.points}}
      </view>
    </view>
    <button 
      class="action-btn" 
      hover-class="btn-hover"
      catchtap="showDeleteConfirm" 
      data-id="{{item._id}}"
    >🗑️</button>
  </view>
</view>

<!-- 悬浮添加按钮 -->
<view class="fab" bindtap="goToAdd">
  <text class="fab-icon">+</text>
</view>

<modal
  visible="{{showDeleteModal}}"
  title="删除确认"
  content="确定要删除该刮刮卡吗？"
  bind:confirm="confirmDelete"
  bind:cancel="hideDeleteModal"
/> 