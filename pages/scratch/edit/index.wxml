<!--pages/scratch/edit/index.wxml-->
<nav-bar title="{{id ? '编辑刮刮卡' : '新建刮刮卡'}}">
  <view slot="left">
    <text class="back-btn" bindtap="goBack">返回</text>
  </view>
</nav-bar>

<view class="container">
  <form bindsubmit="handleSubmit">
    <view class="form-group">
      <view class="form-item">
        <text class="label">标题</text>
        <input 
          class="input" 
          name="title" 
          value="{{form.title}}"
          placeholder="请输入标题"
          maxlength="20"
          bindinput="onInput"
          data-field="title"
        />
      </view>

      <view class="form-item">
        <text class="label">描述</text>
        <textarea 
          class="textarea" 
          name="description"
          value="{{form.description}}"
          placeholder="请输入描述"
          maxlength="100"
          bindinput="onInput"
          data-field="description"
        />
      </view>

      <view class="form-item">
        <text class="label">积分</text>
        <input 
          class="input" 
          type="number"
          name="points"
          value="{{form.points}}"
          placeholder="请输入积分"
          bindinput="onInput"
          data-field="points"
        />
      </view>

      <view class="form-item">
        <text class="label">中奖概率</text>
        <slider 
          name="probability"
          value="{{form.probability * 100}}"
          min="0"
          max="100"
          show-value
          bindchange="onProbabilityChange"
        />
      </view>
    </view>

    <view class="footer">
      <button 
        class="submit-btn" 
        type="primary" 
        loading="{{submitting}}"
        form-type="submit"
      >保存</button>

      <button 
        class="delete-btn" 
        bindtap="showDeleteConfirm"
      >删除</button>
    </view>
  </form>

  <modal
    visible="{{showDeleteModal}}"
    title="删除确认"
    content="确定要删除该刮刮卡吗？删除后无法恢复。"
    bind:confirm="handleDelete"
    bind:cancel="hideDeleteModal"
  />
</view>