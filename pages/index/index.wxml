<skeleton wx:if="{{loading}}" />

<view class="container">
  <!-- 顶部栏 -->
  <view class="header">
    <child-switcher 
      currentChild="{{currentChild}}"
      bind:switch="onChildSwitch"
    />
    <navigator 
      class="settings"
      url="/pages/settings/index"
      hover-class="none"
    >
      <text class="icon">⚙️</text>
    </navigator>
  </view>

  <!-- 加载中 -->
  <view class="loading" wx:if="{{loading}}">
    <loading />
  </view>

  <!-- 空状态 -->
  <view class="empty" wx:elif="{{!currentChild}}">
    <text class="icon">👶</text>
    <text class="text">还没有添加宝贝</text>
    <button 
      class="add-btn"
      type="primary"
      bindtap="goToAddChild"
    >添加宝贝</button>
  </view>

  <!-- 主内容 -->
  <block wx:else>
    <!-- 孩子信息 -->
    <view class="child-info" bindtap="goToEditChild">
      <block wx:if="{{currentChild.avatar}}">
        <image 
          class="avatar" 
          src="{{currentChild.avatar}}" 
          mode="aspectFill"
          binderror="onImageError"
        />
      </block>
      <view wx:else class="text-avatar">{{currentChild.name[0]}}</view>
      <view class="info">
        <text class="name">{{currentChild.name}}</text>
        <text class="age">{{currentChild.age}}</text>
      </view>
      <view class="points">
        <text class="label">积分</text>
        <text class="value">{{currentChild.points}}</text>
      </view>
    </view>

    <!-- 家人信息 -->
    <view class="family-info">
      <card title="👨‍👩‍👧‍👦 家人" subtitle="管理" bind:more="goToFamilyManage">
        <view class="family-list">
          <block wx:if="{{familyList.length}}">
            <view class="family-grid">
              <view 
                class="family-item" 
                wx:for="{{familyList}}" 
                wx:key="_id"
                bindtap="editFamily"
                data-id="{{item.memberId}}"
              >
                <view class="text-avatar">{{item.name[0]}}</view>
                <text class="name">{{item.name}}</text>
                <text class="role">{{item.role}}</text>
              </view>
              <view class="family-item add" bindtap="addFamilyMember">
                <text class="icon">+</text>
                <text class="text">添加家人</text>
              </view>
            </view>
          </block>
          <view class="empty-family" wx:else bindtap="addFamilyMember">
            <text class="icon">👨‍👩‍👧‍👦</text>
            <text class="text">添加家人</text>
          </view>
        </view>
      </card>
    </view>

    <!-- 积分概览 -->
    <view class="overview">
      <card 
        title="📅 日历" 
        subtitle="查看更多"
        bindmore="goToRecords"
      >
        <!-- 日历头部 -->
        <view class="calendar-header">
          <view class="weekday" wx:for="{{['日','一','二','三','四','五','六']}}" wx:key="*this">
            {{item}}
          </view>
        </view>
        
        <!-- 月份显示 -->
        <view class="month-title">{{currentMonth}}</view>
        
        <!-- 日历主体 -->
        <view class="calendar-body">
          <view class="calendar-row" wx:for="{{calendarData}}" wx:for-item="row" wx:key="index">
            <view 
              class="calendar-cell {{item.isToday ? 'today' : ''}} {{item.hasRecords ? 'has-records' : ''}}" 
              wx:for="{{row}}" 
              wx:key="date"
              data-date="{{item.date}}"
              bindtap="onDateClick"
            >
              <text class="date">{{item.day}}</text>
              <block wx:if="{{item.hasRecords}}">
                <view class="points reward" wx:if="{{item.reward}}">🌸 +{{item.reward}}</view>
                <view class="points penalty" wx:if="{{item.penalty}}">💪 -{{item.penalty}}</view>
              </block>
            </view>
          </view>
        </view>
      </card>
    </view>

    <!-- 快捷功能 -->
    <card title="便捷功能">
      <view class="quick-actions">
        <view class="action-item" bindtap="goToAddChild">
          <text class="icon">👶</text>
          <text class="text">添加宝贝</text>
        </view>
        <view class="action-item" bindtap="goToRules">
          <text class="icon">📋</text>
          <text class="text">规则管理</text>
        </view>
        <view class="action-item" bindtap="addRecord">
          <text class="icon">🌸</text>
          <text class="text">积分记录</text>
        </view>
        <view class="action-item" bindtap="goToStats">
          <text class="icon">📊</text>
          <text class="text">数据统计</text>
        </view>
        <view class="action-item" bindtap="playScratchGame">
          <text class="icon">🎰</text>
          <text class="text">刮刮卡</text>
        </view>
      </view>
    </card>

    <!-- 最近记录 -->
    <view class="recent-records">
      <card 
        title="最近记录" 
        subtitle="查看更多" 
        bind:more="goToRecords"
      >
        <view class="record-list">
          <view class="record-item" wx:for="{{recentRecords}}" wx:key="_id">
            <view class="avatar-wrapper">
              <block wx:if="{{currentChild.avatar}}">
                <image 
                  class="avatar" 
                  src="{{currentChild.avatar}}" 
                  mode="aspectFill"
                  binderror="onImageError"
                />
              </block>
              <view wx:else class="text-avatar">{{currentChild.name[0]}}</view>
            </view>
            <view class="content">
              <view class="title">
                <text class="name">{{currentChild.name}}</text>
                <text class="points {{item.type === 'reward' ? 'plus' : 'minus'}}">
                  {{item.type === 'reward' ? '+' : '-'}}{{item.points}}
                </text>
              </view>
              <view class="desc">
                <text>{{item.ruleName}}</text>
                <text class="time">{{item.createTime}}</text>
              </view>
            </view>
          </view>
        </view>
      </card>
    </view>
  </block>
</view> 