@import '/styles/variables.wxss';

.container {
  min-height: 100vh;
  background: var(--background);
  padding-bottom: env(safe-area-inset-bottom);
  animation: fadeIn 0.3s;
}

/* 顶部区域 */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  padding-top: calc(24rpx + env(safe-area-inset-top));
  background: var(--gradient-primary);
  color: #fff;
  overflow: hidden;
}

.header::after {
  content: '';
  position: absolute;
  left: 0;
  right: 0;
  bottom: -20rpx;
  height: 40rpx;
  background: var(--background);
  border-radius: 50% 50% 0 0;
}

.settings {
  width: 48rpx;
  height: 48rpx;
  padding: 12rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.settings .icon {
  font-size: 32rpx;
}

.user-info {
  display: flex;
  align-items: center;
  position: relative;
  z-index: 1;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.2);
  transition: transform 0.3s;
}

.avatar:active {
  transform: scale(0.95);
}

.nickname {
  display: block;
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.welcome {
  font-size: 24rpx;
  opacity: 0.8;
}

/* 统计卡片 */
.overview {
  margin: -48rpx 24rpx 24rpx;
  position: relative;
  z-index: 2;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.stat-item {
  text-align: center;
  padding: 24rpx 0;
  transition: transform 0.2s;
}

.stat-item:active {
  transform: scale(0.98);
}

.stat-item .value {
  display: block;
  font-size: 36rpx;
  font-weight: 500;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.stat-item .label {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 快捷功能 */
.quick-actions {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
  padding: 24rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  background: #f5f7fa;
  border-radius: 12rpx;
}

.action-item .icon {
  font-size: 48rpx;
  margin-bottom: 12rpx;
}

.action-item .text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 最近记录 */
.recent-records {
  margin: 0 24rpx;
}

.record-list {
  margin: 0 -24rpx;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
  transition: background-color 0.2s;
}

.record-item:active {
  background-color: var(--primary-light);
}

.record-item:last-child {
  border-bottom: none;
}

.record-item .avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  border: none;
}

.record-item .content {
  flex: 1;
}

.record-item .title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8rpx;
}

.record-item .name {
  font-size: 28rpx;
  color: var(--text-primary);
}

.record-item .points {
  font-size: 28rpx;
  font-weight: 500;
}

/* 积分显示样式 */
.points {
  font-weight: bold;
}

/* 正分显示为红色 */
.plus {
  color: #ff4d4f;  /* 红色 */
}

/* 负分显示为绿色 */
.minus {
  color: #52c41a;  /* 绿色 */
}

/* 添加动画 */
@keyframes slideIn {
  from {
    transform: translateY(20rpx);
    opacity: 0;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.overview,
.quick-actions,
.recent-records {
  animation: slideIn 0.5s ease-out;
}

.stat-item {
  animation: slideIn 0.5s ease-out;
  animation-fill-mode: backwards;
}

.stat-item:nth-child(2) {
  animation-delay: 0.1s;
}

.stat-item:nth-child(3) {
  animation-delay: 0.2s;
}

.stat-item:nth-child(4) {
  animation-delay: 0.3s;
}

.action-item {
  animation: slideIn 0.5s ease-out;
  animation-fill-mode: backwards;
  animation-delay: 0.4s;
}

.record-item {
  animation: slideIn 0.5s ease-out;
  animation-fill-mode: backwards;
}

.record-item:nth-child(1) {
  animation-delay: 0.5s;
}

.record-item:nth-child(2) {
  animation-delay: 0.6s;
}

.record-item:nth-child(3) {
  animation-delay: 0.7s;
}

/* 下拉刷新动画 */
.scroll-view {
  height: 100vh;
  transition: transform 0.3s;
}

.refreshing {
  transform: translateY(100rpx);
}

/* 页面切换动画 */
@keyframes fadeIn {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

/* 卡片切换动画 */
.card {
  transition: transform 0.3s, opacity 0.3s;
}

.card.entering {
  transform: translateY(20rpx);
  opacity: 0;
}

.card.leaving {
  transform: translateY(-20rpx);
  opacity: 0;
}

.loading,
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 48rpx;
}

.empty .icon {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.empty .text {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-bottom: 48rpx;
}

.add-btn {
  padding: 24rpx 48rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: 32rpx;
  font-size: 32rpx;
  border: none;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
}

.add-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}

.child-info {
  margin-top: calc(120rpx + env(safe-area-inset-top));
  padding: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
}

.child-info .avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.child-info .info {
  flex: 1;
}

.child-info .name {
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  display: block;
}

.child-info .age {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.child-info .points {
  text-align: center;
}

.child-info .points .label {
  font-size: 24rpx;
  color: var(--text-secondary);
  display: block;
  margin-bottom: 8rpx;
}

.child-info .points .value {
  font-size: 36rpx;
  color: var(--primary-color);
  font-weight: bold;
}

/* 添加文字头像样式 */
.text-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--primary-color);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  margin-right: 24rpx;
}

/* 孩子信息中的文字头像样式 */
.child-info .text-avatar {
  width: 120rpx;
  height: 120rpx;
  font-size: 48rpx;
}

/* 记录列表中的文字头像样式 */
.record-item .text-avatar {
  width: 80rpx;
  height: 80rpx;
  font-size: 32rpx;
}

/* 家人信息 */
.family-info {
  margin: 24rpx;
}

.family-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx;
  padding: 24rpx 0;
}

.family-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx;
  background: var(--background);
  border-radius: 12rpx;
}

.family-item .text-avatar {
  width: 96rpx;
  height: 96rpx;
  font-size: 36rpx;
  margin-bottom: 12rpx;
  margin-right: 0;
}

.family-item .name {
  font-size: 28rpx;
  margin-bottom: 4rpx;
}

.family-item .role {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.family-item.add {
  border: 2rpx dashed var(--border-color);
  background: transparent;
}

.family-item.add .icon {
  font-size: 48rpx;
  color: var(--text-secondary);
  margin-bottom: 8rpx;
}

.family-item.add .text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.empty-family {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
}

.empty-family .icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-family .text {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.record-item .points.plus {
  color: #ff4d4f;  /* 奖励(正分)显示红色 */
}

.record-item .points.minus {
  color: #52c41a;  /* 惩罚(负分)显示绿色 */
}

.record-item .desc {
  display: flex;
  justify-content: space-between;  /* 规则名称和时间戳两端对齐 */
  align-items: center;
  font-size: 24rpx;
  color: var(--text-disabled);
}

.record-item .rule-name {
  flex: 1;  /* 规则名称占据剩余空间 */
  margin-right: 16rpx;  /* 与时间戳保持间距 */
}

.record-item .time {
  margin-right: 4rpx;  /* 与积分对齐 */
  white-space: nowrap;  /* 时间戳不换行 */
} 