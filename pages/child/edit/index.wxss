.container {
  min-height: 100vh;
  background: var(--background);
  padding: 24rpx;
}

.form {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.input {
  height: 80rpx;
  background: var(--background);
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
}

.picker {
  height: 80rpx;
  background: var(--background);
  border-radius: 8rpx;
  padding: 0 24rpx;
  font-size: 32rpx;
  line-height: 80rpx;
}

.picker.placeholder {
  color: var(--text-placeholder);
}

.gender-select {
  display: flex;
  gap: 24rpx;
}

.gender-option {
  flex: 1;
  height: 120rpx;
  background: var(--background);
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.gender-option.active {
  background: var(--primary-color);
}

.gender-option.active .icon,
.gender-option.active .text {
  color: #fff;
}

.gender-option .icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.gender-option .text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.avatar-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
}

.save-btn {
  margin-top: 48rpx;
  border-radius: 48rpx;
} 