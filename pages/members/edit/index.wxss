.container {
  min-height: 100vh;
  background: var(--background);
  padding: 48rpx 24rpx;
}

/* 头像上传 */
.avatar-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
  border: 4rpx solid rgba(0, 0, 0, 0.1);
}

.upload-tip {
  font-size: 24rpx;
  color: var(--text-secondary);
}

/* 表单样式 */
.form-group {
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 48rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
  margin-bottom: 32rpx;
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

/* 底部按钮 */
.footer {
  padding: 0 48rpx;
}

.submit-btn {
  margin-bottom: 24rpx;
}

.delete-btn {
  background: #fff;
  color: var(--error-color);
}

.delete-btn::after {
  border-color: var(--error-color);
}

.radio-group {
  display: flex;
  gap: 32rpx;
}

.radio-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.radio-label text {
  font-size: 32rpx;
  color: var(--text-primary);
}

.relation-type {
  font-size: 28rpx;
  color: var(--text-secondary);
  padding: 16rpx 24rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
} 