/* pages/members/children/edit/index.wxss */
.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 24rpx;
}

.avatar-upload {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 48rpx;
}

.avatar-image {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 16rpx;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.avatar-tip {
  font-size: 24rpx;
  color: #999;
}

.form-group {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
  margin-bottom: 48rpx;
}

.form-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #eee;
}

.form-item:last-child {
  border-bottom: none;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.form-input {
  font-size: 32rpx;
  color: #333;
  width: 100%;
}

.gender-group {
  display: flex;
  justify-content: space-around;
  padding: 16rpx 48rpx;
}

.gender-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 48rpx;
  border-radius: 12rpx;
  border: 2rpx solid #eee;
}

.gender-item.active {
  background: #e8f7e8;
  border-color: #07c160;
}

.gender-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.gender-text {
  font-size: 28rpx;
  color: #333;
}

.footer {
  padding: 0 48rpx;
}

.submit-btn {
  margin-bottom: 24rpx;
  background: #07c160;
}

.delete-btn {
  background: #fff;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
}

.delete-btn::after {
  border: none;
}