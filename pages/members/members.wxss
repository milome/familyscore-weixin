.container {
  padding: 20rpx;
}

.header {
  padding: 20rpx 0;
  display: flex;
  justify-content: flex-end;
}

.add-btn {
  background: #1aad19;
  color: #fff;
  font-size: 28rpx;
}

.member-list {
  margin-top: 20rpx;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background: #fff;
  border-radius: 10rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.1);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
}

.info {
  flex: 1;
}

.name {
  font-size: 32rpx;
  color: #333;
  display: block;
}

.points {
  font-size: 28rpx;
  color: #666;
}

.actions {
  display: flex;
  gap: 10rpx;
}

.edit-btn {
  background: #1aad19;
  color: #fff;
}

.delete-btn {
  background: #e64340;
  color: #fff;
} 