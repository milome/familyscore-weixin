/* pages/members/list/index.wxss */
.container {
  min-height: 100vh;
  background: var(--background);
  padding: 24rpx;
}

.header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  height: 72rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.add-btn .icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}

.member-list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.member-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.member-item:last-child {
  border-bottom: none;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  margin-right: 24rpx;
}

.content {
  flex: 1;
}

.name {
  font-size: 32rpx;
  color: var(--text-primary);
  margin-bottom: 8rpx;
}

.remark {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 0;
  margin: 0;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 32rpx;
  background: none;
  border: none;
}

.action-btn::after {
  display: none;
}

.btn-hover {
  opacity: 0.7;
}