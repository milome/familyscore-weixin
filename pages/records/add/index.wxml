<!--pages/records/add/index.wxml-->
<view class="container">
  <form bindsubmit="handleSubmit">
    <view class="form-group">
      <view class="form-item">
        <text class="label">日期</text>
        <view class="calendar-container">
          <calendar 
            value="{{form.date}}"
            bind:change="onDateChange"
          />
        </view>
      </view>

      <view class="form-item">
        <text class="label">选择成员</text>
        <picker 
          mode="selector" 
          range="{{memberList}}" 
          range-key="name"
          bindchange="onMemberChange"
        >
          <view class="picker {{selectedMember ? '' : 'placeholder'}}">
            {{selectedMember ? selectedMember.name : '请选择孩子'}}
          </view>
        </picker>
      </view>

      <view class="form-item">
        <text class="label">选择规则</text>
        <picker 
          mode="selector" 
          range="{{ruleList}}" 
          range-key="name"
          bindchange="onRuleChange"
        >
          <view class="picker {{selectedRule ? '' : 'placeholder'}}">
            {{selectedRule ? selectedRule.name : '请选择规则'}}
          </view>
        </picker>
      </view>

      <view class="form-item" wx:if="{{selectedRule}}">
        <text class="label">积分</text>
        <view class="points {{selectedRule.type}}">
          {{selectedRule.type === 'reward' ? '+' : '-'}}{{selectedRule.points}}
        </view>
      </view>
    </view>

    <button 
      class="submit-btn" 
      type="primary" 
      loading="{{submitting}}"
      bindtap="handleSubmit"
    >保存</button>
  </form>
</view>