.container {
  min-height: 100vh;
  background: var(--background);
  padding: 48rpx 24rpx;
}

/* 表单样式 */
.form-group {
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  margin-bottom: 48rpx;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  width: 160rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
}

.input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.picker {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-primary);
}

.picker.placeholder {
  color: var(--text-disabled);
}

.points {
  flex: 1;
  font-size: 32rpx;
  font-weight: 500;
}

.points.plus {
  color: var(--success-color);
}

.points.minus {
  color: var(--error-color);
}

/* 底部按钮 */
.footer {
  padding: 0 48rpx;
}

.submit-btn {
  margin-bottom: 24rpx;
}

.delete-btn {
  background: #fff;
  color: var(--error-color);
}

.delete-btn::after {
  border-color: var(--error-color);
} 