<view class="container">
  <nav-bar title="积分记录">
    <view slot="left">
      <text class="back-btn" bindtap="goBack">返回</text>
    </view>
  </nav-bar>

  <!-- 筛选面板 -->
  <filter-panel>
    <view class="filter-row">
      <date-range 
        startDate="{{filter.startDate}}" 
        endDate="{{filter.endDate}}"
        bind:change="onDateChange"
      />
      <view class="type-filter">
        <text 
          class="type-btn {{filter.type === '' ? 'active' : ''}}" 
          data-type="" 
          bindtap="onTypeChange"
        >全部</text>
        <text 
          class="type-btn {{filter.type === 'reward' ? 'active' : ''}}" 
          data-type="reward" 
          bindtap="onTypeChange"
        >奖励</text>
        <text 
          class="type-btn {{filter.type === 'penalty' ? 'active' : ''}}" 
          data-type="penalty" 
          bindtap="onTypeChange"
        >惩罚</text>
      </view>
    </view>
  </filter-panel>

  <!-- 记录列表 -->
  <view class="record-list">
    <view class="record-item" wx:for="{{records}}" wx:key="_id">
      <view class="user-info">
        <block wx:if="{{currentChild.avatar}}">
          <image 
            class="avatar" 
            src="{{currentChild.avatar}}" 
            mode="aspectFill"
            binderror="onImageError"
          />
        </block>
        <view wx:else class="text-avatar">{{currentChild.name[0]}}</view>
        <text class="name">{{item.memberName}}</text>
      </view>
      <view class="content">
        <view class="title">
          <text class="name">{{item.childName}}</text>
          <text class="points {{item.type === 'reward' ? 'plus' : 'minus'}}">
            {{item.type === 'reward' ? '+' : '-'}}{{item.points}}
          </text>
        </view>
        <view class="desc">
          <text>{{item.ruleName}}</text>
          <text class="time">{{item.createTime}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 悬浮添加按钮 -->
  <view class="fab" bindtap="addRecord">
    <text class="icon">+</text>
  </view>

  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}">
    <text wx:if="{{loading}}">加载中...</text>
    <text wx:else bindtap="loadMore">加载更多</text>
  </view>
</view> 