.search-bar {
  position: sticky;
  top: 0;
  z-index: 10;
}

.filter-tags {
  display: flex;
  flex-wrap: wrap;
  padding: 16rpx 24rpx;
  background: #fff;
}

.tag {
  display: flex;
  align-items: center;
  padding: 8rpx 16rpx;
  margin: 8rpx;
  background: #f5f7fa;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #666;
}

.tag .clear {
  width: 24rpx;
  height: 24rpx;
  margin-left: 8rpx;
}

.record-list {
  flex: 1;
}

.btn-icon {
  padding: 0;
  margin: 0;
  border: none;
  background: none;
  line-height: 1;
}

.btn-icon::after {
  display: none;
}

.btn-icon image {
  width: 48rpx;
  height: 48rpx;
}

.container {
  min-height: 100vh;
  background: var(--background);
  padding: 24rpx;
}

.header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.add-btn {
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  height: 72rpx;
  background: var(--primary-color);
  color: #fff;
  border-radius: 36rpx;
  font-size: 28rpx;
}

.add-btn .icon {
  font-size: 36rpx;
  margin-right: 8rpx;
}

/* 筛选面板 */
.filter-row {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.type-filter {
  display: flex;
  gap: 24rpx;
}

.type-btn {
  flex: 1;
  text-align: center;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--border-color);
  font-size: 28rpx;
  color: var(--text-secondary);
  transition: all 0.3s;
}

.type-btn.active {
  background: var(--primary-color);
  border-color: var(--primary-color);
  color: #fff;
}

/* 记录列表 */
.record-list {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.record-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.record-item:active {
  background-color: var(--primary-light);
}

.record-item:last-child {
  border-bottom: none;
}

.text-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #1890ff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  overflow: hidden;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.text-avatar text {
  color: #fff;
  font-size: 32rpx;
}

.record-item .content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.record-item .title {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.record-item .name {
  font-size: 28rpx;
  color: var(--text-primary);
}

.record-item .points {
  font-size: 28rpx;
  font-weight: 500;
  position: absolute;
  right: 24rpx;
}

.record-item .points.plus {
  color: #ff4d4f;
}

.record-item .points.minus {
  color: #52c41a;
}

.record-item .desc {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--text-disabled);
}

.record-item .rule-name {
  display: block;
}

.record-item .time {
  display: block;
  text-align: right;
  margin-right: 4rpx;
}

/* 加载更多 */
.load-more {
  text-align: center;
  padding: 24rpx;
  color: var(--text-secondary);
  font-size: 28rpx;
} 