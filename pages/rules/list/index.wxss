/* pages/rules/list/index.wxss */
.container {
  min-height: 100vh;
  background: var(--background);
}

.header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  background: #fff;
}

.add-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 32rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: var(--primary-color);
  color: #fff;
}

.add-btn .icon {
  font-size: 40rpx;
  font-weight: bold;
}

.rule-list {
  padding: 24rpx;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 48rpx 0;
  color: var(--text-secondary);
}

.empty .icon {
  font-size: 80rpx;
}

.empty .text {
  font-size: 28rpx;
}

.rule-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 24rpx;
  background: #fff;
  border-radius: 12rpx;
}

.rule-item .content {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-right: 24rpx;
}

.rule-item .name {
  font-size: 32rpx;
  color: var(--text-primary);
}

.rule-item .points {
  font-size: 32rpx;
  font-weight: bold;
}

.rule-item .points.reward {
  color: var(--success-color);
}

.rule-item .points.penalty {
  color: var(--error-color);
}

.rule-item .actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 0;
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  background: none;
  border: none;
}

.action-btn::after {
  display: none;
}

.btn-hover {
  opacity: 0.7;
}