/* pages/rules/list/index.wxss */
.container {
  min-height: 100vh;
  background: var(--background);
  padding: 24rpx;
  position: relative;
}

.rule-list {
  padding: 24rpx;
}

.rule-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
}

.rule-item .content {
  flex: 1;
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-right: 32rpx;
}

.rule-item .name {
  font-size: 32rpx;
  color: var(--text-primary);
}

.rule-item .points {
  font-size: 32rpx;
  font-weight: 500;
}

.rule-item .points.reward {
  color: #ff4d4f;
}

.rule-item .points.penalty {
  color: #52c41a;
}

.rule-item .actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  padding: 0;
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  background: none;
  border: none;
  font-size: 32rpx;
}

.action-btn::after {
  display: none;
}

.btn-hover {
  opacity: 0.7;
}

/* 悬浮添加按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.2);
}

.fab .icon {
  color: #fff;
  font-size: 60rpx;
  font-weight: bold;
}

.fab:active {
  transform: scale(0.95);
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  color: var(--text-secondary);
}

.empty .icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty .text {
  font-size: 28rpx;
}