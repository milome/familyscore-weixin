<view class="container">
  <view class="header">
    <button class="add-btn" bindtap="addRule">添加规则</button>
  </view>
  
  <view class="rule-list">
    <view class="rule-item" wx:for="{{rules}}" wx:key="_id">
      <view class="rule-info">
        <text class="title">{{item.title}}</text>
        <view class="points-info">
          <text class="points {{item.points >= 0 ? 'positive' : 'negative'}}">
            {{item.points >= 0 ? '+' : ''}}{{item.points}}分
          </text>
        </view>
        <text class="description">{{item.description}}</text>
      </view>
      <view class="actions">
        <button class="edit-btn" size="mini" bindtap="editRule" data-id="{{item._id}}">编辑</button>
        <button class="delete-btn" size="mini" bindtap="deleteRule" data-id="{{item._id}}">删除</button>
      </view>
    </view>
  </view>
</view> 