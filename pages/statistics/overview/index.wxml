<!--pages/statistics/overview/index.wxml-->
<nav-bar title="统计分析" />

<view class="stats-cards">
  <card title="总览">
    <view class="overview-stats">
      <view class="stat-item">
        <text class="value">{{stats.total || 0}}</text>
        <text class="label">总记录数</text>
      </view>
      <view class="stat-item">
        <text class="value">{{stats.totalPoints || 0}}</text>
        <text class="label">总积分</text>
      </view>
      <view class="stat-item">
        <text class="value">{{stats.rewards || 0}}</text>
        <text class="label">奖励次数</text>
      </view>
      <view class="stat-item">
        <text class="value">{{stats.penalties || 0}}</text>
        <text class="label">惩罚次数</text>
      </view>
    </view>
  </card>
</view>