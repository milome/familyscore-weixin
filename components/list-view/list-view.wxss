.list-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
}

.loading-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx;
  color: #999;
  font-size: 24rpx;
}

.loading-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  animation: rotate 1s linear infinite;
}

.no-more {
  text-align: center;
  padding: 24rpx;
  color: #999;
  font-size: 24rpx;
}

.list-item {
  box-sizing: border-box;
}

.list-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: var(--text-primary);
}

.list-button {
  padding: 0;
  margin: 0;
  background: none;
  border: none;
}

.list-button::after {
  display: none;
}

.empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  color: var(--text-secondary);
}

.empty image {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 24rpx;
}

.empty text {
  color: #999;
  font-size: 28rpx;
}

.list-image {
  width: 100%;
  height: 100%;
}

.list-text {
  font-size: 28rpx;
  color: var(--text-primary);
}

@keyframes rotate {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
} 