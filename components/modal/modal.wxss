.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  visibility: hidden;
}

.modal.show {
  visibility: visible;
}

.mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
  opacity: 0;
  transition: opacity 0.3s;
}

.modal.show .mask {
  opacity: 1;
}

.content {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%) scale(0.8);
  width: 560rpx;
  background: #fff;
  border-radius: 12rpx;
  opacity: 0;
  transition: all 0.3s;
}

.modal.show .content {
  transform: translate(-50%, -50%) scale(1);
  opacity: 1;
}

.header {
  padding: 24rpx;
  text-align: center;
  border-bottom: 1rpx solid var(--border-color);
}

.title {
  font-size: 32rpx;
  font-weight: 500;
  color: var(--text-primary);
}

.body {
  padding: 48rpx 24rpx;
  text-align: center;
  font-size: 28rpx;
  color: var(--text-secondary);
  min-height: 100rpx;
}

.footer {
  display: flex;
  border-top: 1rpx solid var(--border-color);
}

.btn {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  padding: 24rpx 0;
  border-radius: 0;
  background: none;
}

.btn::after {
  display: none;
}

.btn.cancel {
  color: var(--text-secondary);
  border-right: 1rpx solid var(--border-color);
}

.btn.confirm {
  color: var(--primary-color);
} 