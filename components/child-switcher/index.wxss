.switcher {
  display: flex;
  align-items: center;
  padding: 12rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 32rpx;
}

.avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.name {
  font-size: 28rpx;
  margin-right: 8rpx;
}

.icon {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.drawer-content {
  padding: 32rpx;
  min-height: 100vh;
  background: #fff;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32rpx;
}

.title {
  font-size: 36rpx;
  font-weight: bold;
}

.add-btn {
  font-size: 28rpx;
  color: var(--primary-color);
}

.child-list {
  padding-bottom: env(safe-area-inset-bottom);
}

.child-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  background: var(--background);
}

.child-item.active {
  background: var(--primary-light);
}

.child-item .avatar {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
}

.child-item .info {
  flex: 1;
}

.child-item .name {
  font-size: 32rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
  display: block;
}

.child-item .age {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.check-icon {
  font-size: 40rpx;
  color: var(--primary-color);
} 