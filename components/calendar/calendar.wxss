.calendar {
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.1);
  overflow: hidden;
  margin: 24rpx;
}

.calendar-header {
  background: linear-gradient(135deg, #07c160, #05a050);
  color: #fff;
  padding: 32rpx 24rpx;
  text-align: center;
}

.year-month {
  margin-bottom: 16rpx;
}

.year {
  font-size: 28rpx;
  opacity: 0.9;
  margin-right: 16rpx;
}

.month {
  font-size: 56rpx;
  font-weight: bold;
}

.selected-date {
  font-size: 24rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  text-align: center;
  padding: 24rpx 0;
  background: #fafafa;
  font-size: 24rpx;
  color: #999;
  border-bottom: 1rpx solid #f0f0f0;
}

.weekday {
  font-weight: 500;
}

.days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  padding: 24rpx 16rpx;
  gap: 8rpx;
  background: #fff;
}

.day {
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  border-radius: 8rpx;
  position: relative;
  transition: all 0.2s;
}

.day.other-month {
  color: #999;
  opacity: 0.5;
}

.day.today {
  color: #07c160;
  font-weight: bold;
  position: relative;
}

.day.today::after {
  content: '';
  position: absolute;
  bottom: 4rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #07c160;
}

.day.selected {
  background: #07c160;
  color: #fff;
  transform: scale(0.9);
}

.day:active {
  opacity: 0.7;
  transform: scale(0.95);
}

.input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #fff;
  border-radius: 8rpx;
}

.value {
  font-size: 32rpx;
  color: var(--text-primary);
}

.icon {
  font-size: 36rpx;
} 