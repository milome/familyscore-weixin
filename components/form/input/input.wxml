<view class="form-item {{error ? 'error' : ''}}">
  <view class="label" wx:if="{{label}}">{{label}}</view>
  <view class="input-wrapper">
    <input
      class="input"
      value="{{value}}"
      type="{{type}}"
      password="{{password}}"
      placeholder="{{placeholder}}"
      placeholder-class="placeholder"
      disabled="{{disabled}}"
      maxlength="{{maxlength}}"
      bindinput="onInput"
      bindblur="onBlur"
      bindfocus="onFocus"
    />
    <view class="clear" wx:if="{{clearable && value}}" bindtap="onClear">
      <image src="/images/icons/clear.png" mode="aspectFit" />
    </view>
  </view>
  <view class="error-msg" wx:if="{{error}}">{{error}}</view>
</view> 