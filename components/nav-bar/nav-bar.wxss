.nav-bar {
  background: #fff;
  z-index: 100;
}

.nav-bar.fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
}

.nav-bar-content {
  height: 44px;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.left {
  width: 88rpx;
  height: 100%;
  display: flex;
  align-items: center;
}

.back-icon {
  font-size: 48rpx;
  color: var(--text-primary);
  padding: 24rpx;
  margin: -24rpx;
}

.title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 500;
  color: #333;
}

.right {
  width: 88rpx;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: flex-end;
} 