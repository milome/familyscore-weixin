.search {
  flex: 1;
}

.search-bar {
  display: flex;
  align-items: center;
  height: 72rpx;
  background: #fff;
  border-radius: 36rpx;
  padding: 0 24rpx;
}

.icon {
  font-size: 32rpx;
  color: var(--text-secondary);
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 28rpx;
  color: var(--text-primary);
}

.clear-btn {
  font-size: 24rpx;
  color: var(--text-disabled);
  padding: 12rpx;
  margin: -12rpx;
}

.clear-btn:active {
  opacity: 0.7;
}

.placeholder {
  color: #999;
}

.clear {
  padding: 10rpx;
}

.clear image {
  width: 32rpx;
  height: 32rpx;
}

.cancel {
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #666;
}

.search-history {
  padding: 24rpx;
}

.history-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  font-size: 28rpx;
  color: #666;
}

.clear-history {
  width: 32rpx;
  height: 32rpx;
  padding: 10rpx;
}

.history-list {
  display: flex;
  flex-wrap: wrap;
}

.history-item {
  padding: 12rpx 24rpx;
  margin: 0 16rpx 16rpx 0;
  background: #f5f7fa;
  border-radius: 32rpx;
  font-size: 24rpx;
  color: #666;
} 