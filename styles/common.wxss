/* 全局基础样式 */
.container {
  padding: 24rpx;
  background: #f5f7fa;
  min-height: 100vh;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

/* 标题样式 */
.title {
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 24rpx;
}

/* 列表样式 */
.list-item {
  padding: 24rpx;
  border-bottom: 1rpx solid #eee;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 按钮样式 */
.btn {
  padding: 20rpx 32rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-primary {
  background: #07c160;
  color: #fff;
}

.btn-default {
  background: #f5f5f5;
  color: #333;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 24rpx;
  color: #999;
}

/* 空状态 */
.empty {
  text-align: center;
  padding: 48rpx 24rpx;
  color: #999;
} 