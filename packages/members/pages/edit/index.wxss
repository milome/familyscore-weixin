/* packages/members/pages/edit/index.wxss */
.container {
  min-height: 100vh;
  background: var(--background);
  padding: 24rpx;
}

.form-group {
  background: #fff;
  border-radius: 12rpx;
  overflow: hidden;
}

.form-item {
  padding: 24rpx;
  border-bottom: 1rpx solid var(--border-color);
}

.form-item:last-child {
  border-bottom: none;
}

.label {
  display: block;
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.input {
  font-size: 32rpx;
  color: var(--text-primary);
}

.avatar-wrapper {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
}

.tip {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.footer {
  margin-top: 48rpx;
  padding: 0 24rpx;
}

.submit-btn {
  margin-bottom: 24rpx;
}

.delete-btn {
  color: var(--error-color);
  background: none;
}

.delete-btn::after {
  border-color: var(--error-color);
}